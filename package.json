{
  "name": "vo-coder",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-agnostic LLM agent harness — the tool shed. Electron desktop app bundling a markdown scaffolding system and a universal infrastructure MCP.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/desktop",
    "build": "tsc -b && npm run build -w apps/desktop",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -b && npm run typecheck -w apps/desktop",
    "mobile": "npm run start -w @vo-coder/mobile",
    "lint": "eslint .",
    "format": "prettier --write .",
    "preview": "node scripts/preview-desktop.mjs",
    "preview:stop": "node scripts/preview-desktop.mjs --stop",
    "preview:restart": "node scripts/preview-desktop.mjs --restart"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.0.0",
    "eslint": "^9.0.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.6.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.44.0"
  }
}
